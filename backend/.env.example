# KrishiMitra Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./krishimitra.db

# Cloud AI Provider Configuration (Options: local, openai, gemini)
# Use 'gemini' or 'openai' for the supercharged online voice LLM agent, or 'local' for ICAR verified facts
AI_FALLBACK_PROVIDER=local

# Cloud AI API Keys (Optional - for high-performance server-side LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Weather API (Default uses Open-Meteo free agricultural API, no key required)
WEATHER_PROVIDER=open_meteo

# Twilio Telephony Configuration (For AI Kisan Phone Helpline)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TELEPHONY_DEFAULT_LANGUAGE=hi-IN
TELEPHONY_TTS_VOICE=Polly.Aditi
TELEPHONY_SEND_SMS_SUMMARY=True
BASE_WEBHOOK_URL=https://your-ngrok-id.ngrok-free.app
